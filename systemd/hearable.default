# /etc/default/hearable — configurazione dell'appliance HearAble sul T9.

# Quanto il T9 aspetta, senza sessione audio dal decoder, prima di spegnersi.
# Il segnale è la presenza della sessione, non il parlato: un canale può essere
# silenzioso o trasmettere musica per mezz'ora ed è comunque acceso.
HEARABLE_IDLE_POWEROFF_MINUTES=20

# Quanto aspettare quando il decoder ha salutato prima di andarsene — spegnimento,
# standby profondo o riavvio di enigma2. È un'attesa breve e non uno spegnimento
# immediato di proposito: enigma2 saluta anche quando riparte per un aggiornamento,
# e un riavvio non deve portarsi via l'appliance. Se il decoder torna entro questa
# finestra, il timer si annulla come sempre.
HEARABLE_IDLE_GRACE_MINUTES=3
