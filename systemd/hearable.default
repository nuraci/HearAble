# /etc/default/hearable — the HearAble appliance on the mini PC.

# How long the mini PC waits, with no audio session from the receiver, before
# switching itself off. The signal is the session's presence, not speech: a
# channel can be silent, or play music for half an hour, and still be on.
HEARABLE_IDLE_POWEROFF_MINUTES=20

# How long to wait once the receiver has said goodbye — switched off, deep
# standby, or Enigma2 restarting. Deliberately a short wait rather than an
# immediate power-off: Enigma2 says goodbye when it restarts for an image
# update too, and a restart must not take the appliance with it. A receiver
# that comes back inside this window cancels the timer like any other
# returning session.
HEARABLE_IDLE_GRACE_MINUTES=3
